# ---------------------------------------------------------
# Node.js / Backend
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log

# ---------------------------------------------------------
# Python / Controller
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/

# Python logs / temporary files
*.log
*.tmp

# Generated QR / image files
current_qr_image*
qr_image*
qr_capture*
*.jpeg
*.jpg
*.png

# ---------------------------------------------------------
# Android / Flutter
# ---------------------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages

**/build/
**/.gradle/
**/local.properties

**/android/.gradle/
**/android/app/build/
**/android/app/.cxx/
**/android/key.properties

**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id

# Flutter generated files
**/*.g.dart
**/*.freezed.dart

# ---------------------------------------------------------
# Android APK / generated binaries
# ---------------------------------------------------------
*.apk
*.aab

# ---------------------------------------------------------
